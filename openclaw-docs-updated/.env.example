# .env.example — Avery & Bryant AI Agent Credentials
# Copy this file, fill in real values, and add to ~/.zshrc
# NEVER commit real credentials to git or paste them in any markdown file

# GoHighLevel (CRM, revenue, leads, messaging)
GHL_API_TOKEN=pit-your-token-here
GHL_LOCATION_ID=your-location-id-here

# ClickUp (project management, shoot scheduling, Red Flags)
CLICKUP_API_TOKEN=pk_your-token-here
CLICKUP_TEAM_ID=your-team-id-here

# Stripe (payments, invoices, MRR)
STRIPE_SECRET_KEY=sk_live_your-key-here

# Gmail (inbox monitoring via Comms Manager)
# These come from Google Cloud Console > OAuth 2.0 Credentials
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret-here
